# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # ⚠️  Ne jamais exposer côté client

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # En prod : https://app.compliai.eu

# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...               # ⚠️  Serveur uniquement — jamais exposé au client

# Modèle Claude par défaut + paramètres globaux (cf. lib/ai/config.ts)
AI_DEFAULT_MODEL=claude-opus-4-5
AI_DEFAULT_TEMPERATURE=0.1
AI_MAX_TOKENS_DEFAULT=2000

# Max tokens par outil (surcharges optionnelles)
AI_MAX_TOKENS_CONSULTANT=8192
# Mode « Synthèse courte » (consultant) — plafond sortie dédié
# AI_MAX_TOKENS_CONSULTANT_BRIEF=2048
# Plafond max sortie consultant (plan free) — défaut aligné sur le payant ; baisser si contrôle des coûts
AI_MAX_TOKENS_CONSULTANT_FREE=8192
# Budgets adaptatifs consultant (optionnels) : simple / modéré / complexe jusqu’au plafond consultant
# AI_CONSULTANT_TOKENS_SIMPLE=1600
# AI_CONSULTANT_TOKENS_MODERATE=8192
# AI_CONSULTANT_TOKENS_COMPLEX=8192
# ─── Scanner page web (bêta) — diagnostic exploratoire HTML / description / questionnaire
# Défaut : rapport complet (~2500 tokens sortie), déterministe
AI_MAX_TOKENS_SCANNER=2500
AI_TEMPERATURE_SCANNER=0.1
# AI_SCANNER_MODEL=claude-sonnet-4-5
AI_MAX_TOKENS_DOC_ART11=4500
AI_TEMPERATURE_DOC_ART11=0.1
# Modèle réservé à l’outil Art. 11 — défaut AI_DEFAULT_MODEL si vide
# AI_ART11_MODEL=claude-sonnet-4-5

AI_MAX_TOKENS_DOC_FRIA=16384
# FRIA Art. 27 : JSON très long — augmenter si erreur de parse (ex. 24000 / 32000 selon modèle)
AI_TEMPERATURE_DOC_FRIA=0.1
# Modèle dédié FRIA Art. 27 (optionnel ; défaut : AI_DEFAULT_MODEL)
# AI_FRIA_MODEL=claude-sonnet-4-5
AI_MAX_TOKENS_DOC_MEMOIRE=3500
AI_MAX_TOKENS_CERVEAU=1500
AI_MAX_TOKENS_QUIZ=6144
# AI_TEMPERATURE_QUIZ=0.3
# AI_TEMPERATURE_QUIZ_REFINE=0.1
# AI_QUIZ_ETUDIANTS_MODEL=claude-sonnet-4-20250514
# 2ᵉ passe « relecture juridique » du quiz (/api/legal-tools) — défaut 0.1
AI_TEMPERATURE_QUIZ_REFINE=0.1
# Résumé d'arrêts / mode conversationnel professeur (clé `arrets_guide`, défaut 4000)
AI_MAX_TOKENS_ARRETS_GUIDE=4000
# AI_TEMPERATURE_ARRETS_GUIDE=0.2
# AI_ARRETS_ETUDIANTS_MODEL=claude-sonnet-4-20250514

# Classifieur AI Act (dashboard) — prompt « Sandbox réglementaire » (déterministe)
AI_MAX_TOKENS_CLASSIFIER=3500
AI_TEMPERATURE_CLASSIFIER=0.05
# Modèle dédié (optionnel ; défaut : AI_DEFAULT_MODEL)
# AI_CLASSIFIER_MODEL=claude-sonnet-4-5

# Checklist conformité interactive (dashboard) — sélection profil AI Act/RGPD/NIS2…
AI_MAX_TOKENS_COMPLIANCE_CHECKLIST=4000
AI_TEMPERATURE_COMPLIANCE_CHECKLIST=0.1
# AI_CHECKLIST_MODEL=claude-sonnet-4-5

# Politique d’usage IA employés (Art. 4 AI Act — dashboard)
AI_MAX_TOKENS_POLICY_EMPLOYEE=4000
AI_TEMPERATURE_POLICY_EMPLOYEE=0.15
# AI_POLICY_EMPLOYEE_MODEL=claude-sonnet-4-5

# RoPA — Registre des activités de traitement (Art. 30 RGPD) — sortie JSON étendue
# Défaut max_tokens ≈ 8000 (plancher 6000, plafond 16384 dans le code)
AI_MAX_TOKENS_ROPA=8000
AI_TEMPERATURE_ROPA=0.1
# AI_ROPA_MODEL=claude-sonnet-4-5

# Analyse contrat tiers (Art. 28 RGPD + AI Act déployeur / chaîne) — sortie JSON rapport
AI_MAX_TOKENS_CONTRACT_ANALYSIS=3000
AI_TEMPERATURE_CONTRACT_ANALYSIS=0.05
# Troncation texte contrat côté serveur (UTF-16 / caractères JS) — défaut 16 000
# AI_CONTRACT_ANALYSIS_MAX_INPUT_CHARS=16000
# AI_CONTRACT_ANALYSIS_MODEL=claude-sonnet-4-5

# Analyseur de jurisprudence UE — JSON étendu (sens · valeur · portée)
AI_MAX_TOKENS_JURISPRUDENCE=10000
# AI_JURISPRUDENCE_MODEL=claude-sonnet-4-5

# Recherche jurisprudentielle EU (panorama CJUE/CEDH/DPA)
AI_MAX_TOKENS_RECHERCHE_JP=4000
AI_TEMPERATURE_RECHERCHE_JP=0.2
# AI_RECHERCHE_JP_MODEL=claude-sonnet-4-5
# AI_RECHERCHE_JP_RAG_MATCH=10
# AI_RECHERCHE_JP_RAG_THRESHOLD=0.5

# ─── Corpus juridique (bibliothèque) vs consultant chat ───────────────────────
# Le flux principal : ingestion / agents en arrière-plan (cron, scripts npm,
# registre UE-27) → chunks indexés dans Supabase → le consultant ne fait que du RAG dessus.
# Reco prod pour coller au modèle « bibliothèque toujours à jour », sans métier au fil de l’eau sur chaque question :
#   NATIONAL_CORPUS_AGENTS_CHAT=0     # aucun agent Claude déclenché par une conversation
#   NATIONAL_AUTO_INGEST=0          # aucun téléchargement national lazy au chat (uniquement crons / backfill / ingest manuel)
# En dev, vous pouvez laisser l’ingestion au chat activée pour compléter vite un pays.

# ─── OpenAI (embeddings RAG : legal_chunks + national_legal_texts) ───────────
OPENAI_API_KEY=sk-...                      # Serveur uniquement
# Ingestion nationale « lazy » au chat (URL allowlist registre). Désactiver en prod bibliothèque : NATIONAL_AUTO_INGEST=0
# Scope RAG lois/JP nationale : auto (défaut ; UE-27 si question paneuropéenne), eu27 (toujours filtrer sur les 27), detected_only (pays détectés dans la question uniquement).
# NATIONAL_RAG_SCOPE=auto
# NATIONAL_AUTO_INGEST_BUDGET_MS=12000    # budget max par liste de pays par message
# NATIONAL_AUTO_INGEST_TTL_HOURS=168      # avant re-téléchargement d’une même source_url
# NATIONAL_AUTO_INGEST_MAX_CHUNKS=100
# NATIONAL_AUTO_INGEST_MAX_BODY_CHARS=600000
# NATIONAL_AUTO_INGEST_CHUNK_CHARS=2000
# NATIONAL_AUTO_INGEST_HTTP_TIMEOUT_MS=20000

# Agents Claude « corpus national » (outils allowlist) + cron /api/cron/national-corpus-agents
# Backfill manuel UE-27 (séquentiel) : npm run backfill:national-corpus-eu27  [ -- FR DE … ]
# NATIONAL_BACKFILL_DELAY_MS=4000          # pause entre pays ; 0 = sans pause
# NATIONAL_BACKFILL_IGNORE_TTL=1           # forcer même si source encore « fraîche » (TTL ingestion)
# NATIONAL_CORPUS_AGENTS_CHAT=0           # 0 = pas d’agent Claude au chat (reco prod ; maintenance = cron + backfill)
# NATIONAL_AGENT_CHAT_BUDGET_MS=18000
# NATIONAL_AGENT_CHAT_MAX_COUNTRIES=2
# NATIONAL_AGENT_CHAT_MAX_STEPS=8
# NATIONAL_AGENT_CRON_BATCH_SIZE=4       # pays traités par tick horaire (rotation UTC)
# NATIONAL_AGENT_CRON_DEADLINE_MS=120000
# NATIONAL_AGENT_CRON_MAX_STEPS=16
# NATIONAL_AGENT_MAX_STEPS=14
# NATIONAL_AGENT_DEADLINE_MS=55000
# NATIONAL_CORPUS_AGENT_MODEL=           # défaut : même modèle que AI_CONFIG
# NATIONAL_CORPUS_AGENT_TEMPERATURE=0.05

# Seeds jurisprudence EU + États membres (npm run ingest:case-law, cron GET /api/cron/case-law-seeds)
# Calendrier Vercel déjà défini dans vercel.json : national-corpus-agents (chaque heure), case-law-seeds (quotidien).
# EU_CASE_LAW_LIVE_FETCH=0                 # 1 = téléchargement TXT/HTML EUR-Lex par CELEX quand disponible ; sinon corpus embarqué

# Plafonds d'appels IA par utilisateur (lus par le rate limiter applicatif)
AI_RATE_LIMIT_PER_USER_PER_HOUR=50
AI_RATE_LIMIT_FREE_TIER=10

# ─── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...              # ⚠️  Serveur uniquement
STRIPE_WEBHOOK_SECRET=whsec_...

# Plans d'abonnement (Stripe Price IDs) — client ET serveur (webhook)
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# Packs crédits ponctuels (one-time) — 12€ / 45€ / 110€ / 320€
STRIPE_PACK_1000_PRICE_ID=price_...
STRIPE_PACK_5000_PRICE_ID=price_...
STRIPE_PACK_15000_PRICE_ID=price_...
STRIPE_PACK_50000_PRICE_ID=price_...

# Allocations crédits : lib/pricing.ts (free 400 · starter 4500 · pro 18000 · enterprise 60000)

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alerts@compliai.eu       # Doit être un domaine vérifié dans Resend

# ─── Monitoring (Sentry) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...   # Optionnel — monitoring prod
SENTRY_DSN=https://...@sentry.io/...               # Côté serveur

# ─── Cron jobs (Vercel Cron) ──────────────────────────────────────────────────
CRON_SECRET=un-secret-fort-aleatoire       # Protège les routes /api/cron/* (national-corpus-agents, case-law-seeds, …)

# ─── Fonctionnalités optionnelles ─────────────────────────────────────────────
# Admins (séparés par virgule, user_id Supabase)
ADMIN_USER_IDS=uuid1,uuid2

# Redis (Upstash) — rate limiting distribué multi-instance Vercel (sinon mémoire locale)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# Corpus RAG complémentaire (ICO, ISO 42001, NIST, OCDE) — CLI ou cron
# npm run ingest:supplementary-corpus
# GET /api/cron/supplementary-corpus (hebdo, Bearer CRON_SECRET)

# Webhooks sortants — secret HMAC si aucun secret par endpoint (optionnel)
WEBHOOK_SIGNING_FALLBACK_SECRET=

# Crisp chat (optionnel, ID site crisp.chat)
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Slack — commande /compliai → POST /api/slack/commands
SLACK_SIGNING_SECRET=
# Optionnel : afficher le dernier audit de cet user_id dans la réponse Slack
SLACK_MAPPED_SUPABASE_USER_ID=
